# Local dev (same-origin via Vite proxy)
VITE_API_HOST=

# Clerk (React Vite)
VITE_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# JWT template used for admin token (must exist in Clerk Dashboard)
VITE_CLERK_JWT_TEMPLATE=admin

# Prod (origin only, no trailing slash/path):
# VITE_API_HOST=https://api.platform.complementarities.org
